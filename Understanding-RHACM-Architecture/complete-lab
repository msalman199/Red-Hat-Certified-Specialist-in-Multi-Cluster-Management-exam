Task 4: Implementing and Understanding Placement
Subtask 4.1: Creating Placement Policies
Step 13: Switch Back to Hub Cluster
# Return to Hub cluster context
export KUBECONFIG=/home/student/hub-cluster-kubeconfig

# Verify Hub cluster connection
oc whoami
Step 14: Create a Basic Placement Policy
Create a placement policy to understand how workloads are distributed:

# Create a namespace for our placement examples
oc create namespace placement-demo

# Create a basic placement policy
cat << EOF | oc apply -f -
apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: demo-placement
  namespace: placement-demo
spec:
  numberOfClusters: 2
  clusterSets:
  - default
EOF
Step 15: Examine Placement Results
# Check the placement status
oc get placement demo-placement -n placement-demo -o yaml

# View placement decisions
oc get placementdecision -n placement-demo

# Examine detailed placement decision
oc describe placementdecision -n placement-demo
Subtask 4.2: Advanced Placement Configuration
Step 16: Create Label-Based Placement
# Create a placement with cluster label selectors
cat << EOF | oc apply -f -
apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: production-placement
  namespace: placement-demo
spec:
  numberOfClusters: 1
  clusterSets:
  - default
  predicates:
  - requiredClusterSelector:
      labelSelector:
        matchLabels:
          environment: production
EOF
Step 17: Test Placement with Cluster Labels
# Add labels to a managed cluster
oc label managedcluster <cluster-name> environment=production

# Check the updated placement decision
oc get placementdecision -n placement-demo -o yaml

# Verify cluster selection
oc describe placement production-placement -n placement-demo
Subtask 4.3: Understanding Placement Binding
Step 18: Create a PlacementBinding
# Create a sample application for placement binding
cat << EOF | oc apply -f -
apiVersion: apps.open-cluster-management.io/v1
kind: Application
metadata:
  name: demo-app
  namespace: placement-demo
spec:
  componentKinds:
  - group: apps.open-cluster-management.io/v1
    kind: Subscription
  descriptor: {}
  selector:
    matchExpressions:
    - key: app
      operator: In
      values:
      - demo-app
---
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: demo-app-placement
  namespace: placement-demo
spec:
  clusterSelector:
    matchLabels:
      environment: production
EOF
Step 19: Verify Application Placement
# Check application status
oc get application demo-app -n placement-demo -o yaml

# Examine placement rule status
oc describe placementrule demo-app-placement -n placement-demo

# View application distribution
oc get subscription -A | grep demo-app
