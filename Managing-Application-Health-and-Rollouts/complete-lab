Subtask 1.2: Create a Sample Application for Health Monitoring
We'll deploy a sample web application that we can monitor across multiple clusters.

Create a namespace for our application:
# Create application namespace
oc create namespace health-demo
Create the sample application deployment:
cat << 'EOF' > sample-app-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: health-demo-app
  namespace: health-demo
  labels:
    app: health-demo
spec:
  replicas: 3
  selector:
    matchLabels:
      app: health-demo
  template:
    metadata:
      labels:
        app: health-demo
    spec:
      containers:
      - name: web-server
        image: nginx:1.21
        ports:
        - containerPort: 80
        livenessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /
            port: 80
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 2
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "128Mi"
            cpu: "100m"
---
apiVersion: v1
kind: Service
metadata:
  name: health-demo-service
  namespace: health-demo
spec:
  selector:
    app: health-demo
  ports:
  - protocol: TCP
    port: 80
    targetPort: 80
  type: ClusterIP
EOF
Apply the deployment:
oc apply -f sample-app-deployment.yaml
Verify the application is running:
# Check deployment status
oc get deployments -n health-demo

# Check pod status
oc get pods -n health-demo

# Check service
oc get services -n health-demo
Subtask 1.3: Configure RHACM Application Resource
Now we'll create an RHACM Application resource to manage our application across clusters.

Create the Application definition:
cat << 'EOF' > rhacm-application.yaml
apiVersion: app.k8s.io/v1beta1
kind: Application
metadata:
  name: health-demo-app
  namespace: health-demo
  annotations:
    apps.open-cluster-management.io/deployables: ""
spec:
  componentKinds:
  - group: apps.open-cluster-management.io
    kind: Deployable
  descriptor: {}
  selector:
    matchExpressions:
    - key: app
      operator: In
      values:
      - health-demo-app
---
apiVersion: apps.open-cluster-management.io/v1
kind: Deployable
metadata:
  name: health-demo-deployable
  namespace: health-demo
  labels:
    app: health-demo-app
spec:
  template:
    apiVersion: apps/v1
    kind: Deployment
    metadata:
      name: health-demo-app
      labels:
        app: health-demo
    spec:
      replicas: 2
      selector:
        matchLabels:
          app: health-demo
      template:
        metadata:
          labels:
            app: health-demo
        spec:
          containers:
          - name: web-server
            image: nginx:1.21
            ports:
            - containerPort: 80
            livenessProbe:
              httpGet:
                path: /
                port: 80
              initialDelaySeconds: 30
              periodSeconds: 10
            readinessProbe:
              httpGet:
                path: /
                port: 80
              initialDelaySeconds: 5
              periodSeconds: 5
EOF
Apply the RHACM Application:
oc apply -f rhacm-application.yaml
Verify the Application resource:
# Check application status
oc get applications -n health-demo

# Check deployables
oc get deployables -n health-demo
Subtask 1.4: Create Placement Rules and Policies
We need to define where our application should be deployed and what policies should govern it.

Create a Placement Rule:
cat << 'EOF' > placement-rule.yaml
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: health-demo-placement
  namespace: health-demo
spec:
  clusterConditions:
  - status: "True"
    type: ManagedClusterConditionAvailable
  clusterSelector:
    matchLabels:
      environment: production
  clusterReplicas: 2
EOF
Apply the Placement Rule:
oc apply -f placement-rule.yaml
Create a Health Policy:
cat << 'EOF' > health-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: health-demo-policy
  namespace: health-demo
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.IP Information Protection Processes and Procedures
    policy.open-cluster-management.io/controls: PR.IP-1 Baseline Configuration
spec:
  remediationAction: inform
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: health-demo-config-policy
        spec:
          remediationAction: inform
          severity: medium
          namespaceSelector:
            exclude:
            - kube-*
            include:
            - health-demo
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: apps/v1
                kind: Deployment
                metadata:
                  name: health-demo-app
                  namespace: health-demo
                spec:
                  replicas: 2
                  template:
                    spec:
                      containers:
                      - name: web-server
                        livenessProbe:
                          httpGet:
                            path: /
                            port: 80
                          initialDelaySeconds: 30
                          periodSeconds: 10
                        readinessProbe:
                          httpGet:
                            path: /
                            port: 80
                          initialDelaySeconds: 5
                          periodSeconds: 5
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: health-demo-policy-binding
  namespace: health-demo
placementRef:
  name: health-demo-placement
  kind: PlacementRule
  apiGroup: apps.open-cluster-management.io
subjects:
- name: health-demo-policy
  kind: Policy
  apiGroup: policy.open-cluster-management.io
EOF
Apply the Health Policy:
oc apply -f health-policy.yaml
Verify policy deployment:
# Check policy status
oc get policies -n health-demo

# Check placement binding
oc get placementbindings -n health-demo

# Check policy compliance
oc describe policy health-demo-policy -n health-demo
Subtask 1.5: Configure Advanced Health Monitoring
Let's set up more sophisticated health monitoring with custom metrics and alerts.

Create a ServiceMonitor for Prometheus integration:
cat << 'EOF' > service-monitor.yaml
apiVersion: monitoring.coreos.com/v1
kind: ServiceMonitor
metadata:
  name: health-demo-monitor
  namespace: health-demo
  labels:
    app: health-demo
spec:
  selector:
    matchLabels:
      app: health-demo
  endpoints:
  - port: web
    interval: 30s
    path: /metrics
    scheme: http
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: nginx-config
  namespace: health-demo
data:
  nginx.conf: |
    events {
        worker_connections 1024;
    }
    http {
        server {
            listen 80;
            location / {
                root /usr/share/nginx/html;
                index index.html;
            }
            location /health {
                access_log off;
                return 200 "healthy\n";
                add_header Content-Type text/plain;
            }
            location /metrics {
                access_log off;
                return 200 "# HELP nginx_up Nginx is up\n# TYPE nginx_up gauge\nnginx_up 1\n";
                add_header Content-Type text/plain;
            }
        }
    }
EOF
Update the deployment to use the custom configuration:
cat << 'EOF' > updated-deployment.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: health-demo-app
  namespace: health-demo
  labels:
    app: health-demo
spec:
  replicas: 3
  selector:
    matchLabels:
      app: health-demo
  template:
    metadata:
      labels:
        app: health-demo
    spec:
      containers:
      - name: web-server
        image: nginx:1.21
        ports:
        - containerPort: 80
          name: web
        livenessProbe:
          httpGet:
            path: /health
            port: 80
          initialDelaySeconds: 30
          periodSeconds: 10
          timeoutSeconds: 5
          failureThreshold: 3
        readinessProbe:
          httpGet:
            path: /health
            port: 80
          initialDelaySeconds: 5
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 2
        startupProbe:
          httpGet:
            path: /health
            port: 80
          initialDelaySeconds: 10
          periodSeconds: 5
          timeoutSeconds: 3
          failureThreshold: 10
        resources:
          requests:
            memory: "64Mi"
            cpu: "50m"
          limits:
            memory: "128Mi"
            cpu: "100m"
        volumeMounts:
        - name: nginx-config
          mountPath: /etc/nginx/nginx.conf
          subPath: nginx.conf
      volumes:
      - name: nginx-config
        configMap:
          name: nginx-config
---
apiVersion: v1
kind: Service
metadata:
  name: health-demo-service
  namespace: health-demo
  labels:
    app: health-demo
spec:
  selector:
    app: health-demo
  ports:
  - protocol: TCP
    port: 80
    targetPort: 80
    name: web
  type: ClusterIP
EOF
Apply the updated configuration:
# Apply the ConfigMap and ServiceMonitor
oc apply -f service-monitor.yaml

# Update the deployment
oc apply -f updated-deployment.yaml
Verify the health endpoints:
