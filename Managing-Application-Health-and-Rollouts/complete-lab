Subtask 2.6: Configure Alerts and Notifications
Create an AlertManager configuration:
cat << 'EOF' > alert-rules.yaml
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: health-demo-alerts
  namespace: health-demo
  labels:
    app: health-demo
spec:
  groups:
  - name: health-demo.rules
    rules:
    - alert: HealthDemoAppDown
      expr: up{job="health-demo-service"} == 0
      for: 1m
      labels:
        severity: critical
        service: health-demo
      annotations:
        summary: "Health Demo application is down"
        description: "Health Demo application has been down for more than 1 minute"
    
    - alert: HealthDemoHighErrorRate
      expr: rate(nginx_http_requests_total{status=~"5.."}[5m]) > 0.1
      for: 2m
      labels:
        severity: warning
        service: health-demo
      annotations:
        summary: "High error rate detected"
        description: "Error rate is above 10% for more than 2 minutes"
    
    - alert: HealthDemoHighLatency
      expr: histogram_quantile(0.95, rate(nginx_http_request_duration_seconds_bucket[5m])) > 0.5
      for: 5m
      labels:
        severity: warning
        service: health-demo
      annotations:
        summary: "High latency detected"
        description: "95th percentile latency is above 500ms for more than 5 minutes"
EOF
