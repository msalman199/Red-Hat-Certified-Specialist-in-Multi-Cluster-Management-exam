Subtask 2.3: Configure Rollout Strategies
Create a progressive rollout configuration:
cat << 'EOF' > progressive-rollout.yaml
apiVersion: argoproj.io/v1alpha1
kind: Rollout
metadata:
  name: health-demo-rollout
  namespace: health-demo
spec:
  replicas: 6
  strategy:
    canary:
      maxSurge: "25%"
      maxUnavailable: 0
      steps:
      - setWeight: 20
      - pause: {duration: 60s}
      - setWeight: 40
      - pause: {duration: 60s}
      - setWeight: 60
      - pause: {duration: 60s}
      - setWeight: 80
      - pause: {duration: 60s}
      analysis:
        templates:
        - templateName: success-rate
        args:
        - name: service-name
          value: health-demo-service
      trafficRouting:
        nginx:
          stableService: health-demo-service
          canaryService: health-demo-canary-service
  selector:
    matchLabels:
      app: health-demo
  template:
    metadata:
      labels:
        app: health-demo
    spec:
      containers:
      - name: web-server
        image: nginx:1.21
        ports:
        - containerPort: 80
        livenessProbe:
          httpGet:
            path: /health
            port: 80
          initialDelaySeconds: 30
          periodSeconds: 10
        readinessProbe:
          httpGet:
            path: /health
            port: 80
          initialDelaySeconds: 5
          periodSeconds: 5
---
apiVersion: argoproj.io/v1alpha1
kind: AnalysisTemplate
metadata:
  name: success-rate
  namespace: health-demo
spec:
  args:
  - name: service-name
  metrics:
  - name: success-rate
    interval: 30s
    count: 5
    successCondition: result[0] >= 0.95
    provider:
      prometheus:
        address: http://prometheus-server.monitoring.svc.cluster.local:80
        query: |
          sum(rate(nginx_http_requests_total{service="{{args.service-name}}",status!~"5.."}[2m])) /
          sum(rate(nginx_http_requests_total{service="{{args.service-name}}"}[2m]))
EOF
Apply the rollout configuration:
oc apply -f progressive-rollout.yaml
Subtask 2.4: Monitor Rollout Progress
Create a monitoring script:
cat << 'EOF' > monitor-rollout.sh
#!/bin/bash

echo "Monitoring Health Demo Application Rollout"
echo "=========================================="

while true; do
    echo ""
    echo "$(date): Checking rollout status..."
    
    # Check rollout status
    echo "Rollout Status:"
    oc get rollout health-demo-rollout -n health-demo -o custom-columns=NAME:.metadata.name,DESIRED:.spec.replicas,CURRENT:.status.replicas,UP-TO-DATE:.status.updatedReplicas,AVAILABLE:.status.availableReplicas
    
    # Check pod status
    echo ""
    echo "Pod Status:"
    oc get pods -n health-demo -l app=health-demo
    
    # Check service endpoints
    echo ""
    echo "Service Endpoints:"
    oc get endpoints -n health-demo
    
    # Check application health
    echo ""
    echo "Application Health Check:"
    if oc port-forward -n health-demo svc/health-demo-service 8081:80 >/dev/null 2>&1 &
    then
        PF_PID=$!
        sleep 2
        if curl -s http://localhost:8081/health >/dev/null 2>&1; then
            echo "✓ Application is healthy"
        else
            echo "✗ Application health check failed"
        fi
        kill $PF_PID 2>/dev/null
    fi
    
    echo ""
    echo "Press Ctrl+C to stop monitoring"
    sleep 30
done
EOF

chmod +x monitor-rollout.sh
Run the monitoring script:
./monitor-rollout.sh
