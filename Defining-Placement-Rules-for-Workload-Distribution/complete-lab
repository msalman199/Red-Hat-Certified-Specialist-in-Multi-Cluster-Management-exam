Subtask 2.4: Create Custom Monitoring Scripts
Let's create some useful scripts to monitor placement rule effectiveness.

Create a placement monitoring script:
cat << 'EOF' > monitor-placement.sh
#!/bin/bash

echo "=== Placement Rule Monitoring Dashboard ==="
echo "Date: $(date)"
echo ""

echo "1. Active Placement Rules:"
oc get placementrule -A --no-headers | wc -l
echo ""

echo "2. Placement Rules by Namespace:"
oc get placementrule -A -o custom-columns=NAMESPACE:.metadata.namespace,NAME:.metadata.name,CLUSTERS:.status.numberOfSelectedClusters
echo ""

echo "3. Cluster Selection Summary:"
for cluster in $(oc get managedclusters --no-headers -o custom-columns=NAME:.metadata.name); do
    echo "Cluster: $cluster"
    echo "  Labels: $(oc get managedcluster $cluster -o jsonpath='{.metadata.labels}' | tr ',' '\n' | grep -v '^{' | grep -v '^}' | head -3)"
    echo "  Status: $(oc get managedcluster $cluster -o jsonpath='{.status.conditions[?(@.type=="ManagedClusterConditionAvailable")].status}')"
    echo ""
done

echo "4. Recent Placement Decisions:"
oc get placementdecision -A -o custom-columns=NAMESPACE:.metadata.namespace,NAME:.metadata.name,CLUSTERS:.status.decisions[*].clusterName
EOF
Make the script executable and run it:
chmod +x monitor-placement.sh
./monitor-placement.sh
Create a workload distribution analysis script:
cat << 'EOF' > analyze-distribution.sh
#!/bin/bash

echo "=== Workload Distribution Analysis ==="
echo ""

NAMESPACES=("placement-demo")

for ns in "${NAMESPACES[@]}"; do
    echo "Analyzing namespace: $ns"
    echo "------------------------"
    
    # Get all deployments in the namespace
    deployments=$(oc get deployments -n $ns --no-headers -o custom-columns=NAME:.metadata.name 2>/dev/null)
    
    if [ -z "$deployments" ]; then
        echo "No deployments found in namespace $ns"
        continue
    fi
    
    for deployment in $deployments; do
        echo "Deployment: $deployment"
        
        # Check deployment on each cluster
        for cluster in $(oc get managedclusters --no-headers -o custom-columns=NAME:.metadata.name); do
            replica_count=$(oc --context=$cluster get deployment $deployment -n $ns -o jsonpath='{.status.replicas}' 2>/dev/null || echo "0")
            ready_count=$(oc --context=$cluster get deployment $deployment -n $ns -o jsonpath='{.status.readyReplicas}' 2>/dev/null || echo "0")
            echo "  $cluster: $ready_count/$replica_count replicas ready"
        done
        echo ""
    done
done
EOF
Run the distribution analysis:
chmod +x analyze-distribution.sh
./analyze-distribution.sh
