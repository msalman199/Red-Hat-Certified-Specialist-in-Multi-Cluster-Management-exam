Subtask 1.3: Create Cluster Sets
Now we'll create cluster sets to organize our clusters logically.

Create Development Cluster Set
# Create file: dev-clusterset.yaml
apiVersion: cluster.open-cluster-management.io/v1beta2
kind: ManagedClusterSet
metadata:
  name: development
spec:
  clusterSelector:
    selectorType: ExclusiveClusterSetLabel
# Apply the development cluster set
oc apply -f dev-clusterset.yaml

# Verify the cluster set was created
oc get managedclustersets
Create Production Cluster Set
# Create file: prod-clusterset.yaml
apiVersion: cluster.open-cluster-management.io/v1beta2
kind: ManagedClusterSet
metadata:
  name: production
spec:
  clusterSelector:
    selectorType: ExclusiveClusterSetLabel
# Apply the production cluster set
oc apply -f prod-clusterset.yaml
Create Staging Cluster Set
# Create file: staging-clusterset.yaml
