Task 2: Assign Policies Based on Sets and Labels
Subtask 2.1: Understanding Policy Targeting
Policies in RHACM can be targeted to clusters using:

Cluster Sets: Target all clusters in a specific set
Label Selectors: Target clusters with specific labels
Cluster Names: Target specific clusters by name
Combined Selectors: Use multiple criteria for precise targeting
Subtask 2.2: Create Namespace for Policies
Create Policy Namespace
# Create namespace for our policies
oc create namespace cluster-policies

# Verify namespace creation
oc get namespace cluster-policies
Subtask 2.3: Create Development Environment Policy
This policy will apply security configurations to development clusters.

Create Development Security Policy
# Create file: dev-security-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: dev-security-policy
  namespace: cluster-policies
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.AC Identity Management Authentication and Access Control
    policy.open-cluster-management.io/controls: PR.AC-4
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: dev-network-policy
        spec:
          remediationAction: enforce
          severity: medium
          namespaceSelector:
            exclude:
              - kube-*
            include:
              - default
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: networking.k8s.io/v1
                kind: NetworkPolicy
                metadata:
                  name: deny-all-ingress
                  namespace: default
                spec:
                  podSelector: {}
                  policyTypes:
                    - Ingress
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: dev-security-policy-binding
  namespace: cluster-policies
placementRef:
  name: dev-placement
  kind: PlacementRule
  apiGroup: apps.open-cluster-management.io
subjects:
  - name: dev-security-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
---
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: dev-placement
  namespace: cluster-policies
spec:
  clusterSelector:
    matchLabels:
      environment: development
# Apply the development security policy
oc apply -f dev-security-policy.yaml

# Verify policy creation
oc get policy -n cluster-policies
oc get placementrule -n cluster-policies
oc get placementbinding -n cluster-policies
Subtask 2.4: Create Production Environment Policy
This policy will apply stricter security configurations to production clusters.

Create Production Security Policy
# Create file: prod-security-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: prod-security-policy
  namespace: cluster-policies
  annotations:
    policy.open-cluster-management.io/standards: NIST-CSF
    policy.open-cluster-management.io/categories: PR.AC Identity Management Authentication and Access Control
    policy.open-cluster-management.io/controls: PR.AC-1,PR.AC-4
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: prod-pod-security-policy
        spec:
          remediationAction: enforce
          severity: high
          namespaceSelector:
            exclude:
              - kube-*
              - openshift-*
            include:
              - default
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: LimitRange
                metadata:
                  name: prod-resource-limits
                  namespace: default
                spec:
                  limits:
                    - default:
                        cpu: "500m"
                        memory: "512Mi"
                      defaultRequest:
                        cpu: "100m"
                        memory: "128Mi"
                      type: Container
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: prod-network-policy
        spec:
          remediationAction: enforce
          severity: high
          namespaceSelector:
            exclude:
              - kube-*
              - openshift-*
            include:
              - default
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: networking.k8s.io/v1
                kind: NetworkPolicy
                metadata:
                  name: strict-network-policy
                  namespace: default
                spec:
                  podSelector: {}
                  policyTypes:
                    - Ingress
                    - Egress
                  ingress: []
                  egress:
                    - to:
                        - namespaceSelector:
                            matchLabels:
                              name: kube-system
                      ports:
                        - protocol: TCP
                          port: 53
                        - protocol: UDP
                          port: 53
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: prod-security-policy-binding
  namespace: cluster-policies
placementRef:
  name: prod-placement
  kind: PlacementRule
  apiGroup: apps.open-cluster-management.io
subjects:
  - name: prod-security-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
---
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: prod-placement
  namespace: cluster-policies
spec:
  clusterSelector:
    matchLabels:
      environment: production
      criticality: high
# Apply the production security policy
oc apply -f prod-security-policy.yaml
Subtask 2.5: Create Cluster Set-Based Policy
This policy will target all clusters in the staging cluster set.

Create Staging Cluster Set Policy
# Create file: staging-clusterset-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: staging-monitoring-policy
  namespace: cluster-policies
  annotations:
    policy.open-cluster-management.io/standards: Custom
    policy.open-cluster-management.io/categories: Monitoring
    policy.open-cluster-management.io/controls: MON-1
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: staging-monitoring-config
        spec:
          remediationAction: enforce
          severity: medium
          namespaceSelector:
            include:
              - default
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: ConfigMap
                metadata:
                  name: monitoring-config
                  namespace: default
                data:
                  environment: "staging"
                  monitoring.enabled: "true"
                  log.level: "debug"
                  metrics.retention: "7d"
---
apiVersion: cluster.open-cluster-management.io/v1beta1
kind: Placement
metadata:
  name: staging-clusterset-placement
  namespace: cluster-policies
spec:
  clusterSets:
    - staging
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: staging-monitoring-policy-binding
  namespace: cluster-policies
placementRef:
  name: staging-clusterset-placement
  kind: Placement
  apiGroup: cluster.open-cluster-management.io
subjects:
  - name: staging-monitoring-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
# Apply the staging cluster set policy
oc apply -f staging-clusterset-policy.yaml

# Verify all policies are created
oc get policy -n cluster-policies
oc get placement -n cluster-policies
oc get placementrule -n cluster-policies
Subtask 2.6: Create Multi-Label Selector Policy
This policy demonstrates complex label-based targeting.

Create Regional Compliance Policy
# Create file: regional-compliance-policy.yaml
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: us-east-compliance-policy
  namespace: cluster-policies
  annotations:
    policy.open-cluster-management.io/standards: SOC2
    policy.open-cluster-management.io/categories: Compliance
    policy.open-cluster-management.io/controls: CC6.1
spec:
  remediationAction: inform
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: regional-compliance-config
        spec:
          remediationAction: inform
          severity: low
          namespaceSelector:
            include:
              - default
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: v1
                kind: ConfigMap
                metadata:
                  name: compliance-config
                  namespace: default
                data:
                  region: "us-east"
                  compliance.framework: "SOC2"
                  audit.enabled: "true"
                  data.retention: "2555d"  # 7 years
---
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: us-east-placement
  namespace: cluster-policies
spec:
  clusterSelector:
    matchLabels:
      region: us-east
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: us-east-compliance-policy-binding
  namespace: cluster-policies
placementRef:
  name: us-east-placement
  kind: PlacementRule
  apiGroup: apps.open-cluster-management.io
subjects:
  - name: us-east-compliance-policy
    kind: Policy
    apiGroup: policy.open-cluster-management.io
# Apply the regional compliance policy
oc apply -f regional-compliance-policy.yaml
