Task 2: Test SSO Configuration Across Multi-Cluster Environments
Subtask 2.1: Configure Primary OpenShift Cluster
Step 1: Get Cluster Information
# Switch to primary cluster context
oc config use-context cluster1

# Verify cluster access
oc whoami --show-server
oc get nodes
Step 2: Configure OAuth Identity Provider
# Get the current OAuth configuration
oc get oauth cluster -o yaml > oauth-backup.yaml

# Create OAuth configuration with Keycloak
cat << EOF | oc apply -f -
apiVersion: config.openshift.io/v1
kind: OAuth
metadata:
  name: cluster
spec:
  identityProviders:
  - name: keycloak-sso
    mappingMethod: claim
    type: OpenID
    openID:
      clientID: openshift
      clientSecret:
        name: keycloak-client-secret
      issuer: https://$KEYCLOAK_URL/auth/realms/openshift
      claims:
        preferredUsername:
        - preferred_username
        name:
        - name
        email:
        - email
        groups:
        - groups
EOF
Step 3: Create Client Secret
# Create secret for Keycloak client
oc create secret generic keycloak-client-secret \
  --from-literal=clientSecret=openshift-client-secret \
  -n openshift-config

# Verify secret creation
oc get secret keycloak-client-secret -n openshift-config
Step 4: Wait for OAuth Pods to Restart
# Monitor OAuth pod restart
oc get pods -n openshift-authentication -w

# Wait for pods to be ready
oc wait --for=condition=Ready pods -l app=oauth-openshift -n openshift-authentication --timeout=300s
