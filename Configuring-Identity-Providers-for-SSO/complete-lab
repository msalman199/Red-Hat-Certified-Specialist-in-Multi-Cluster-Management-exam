Troubleshooting Common Issues
Issue 1: OAuth Pods Not Restarting
# Force restart OAuth pods
oc delete pods -l app=oauth-openshift -n openshift-authentication

# Check pod logs
oc logs -l app=oauth-openshift -n openshift-authentication
Issue 2: Certificate Issues
# Check certificate validity
openssl s_client -connect $KEYCLOAK_URL:443 -servername $KEYCLOAK_URL

# Update CA bundle if needed
oc get configmap kube-root-ca.crt -n openshift-config -o yaml
Issue 3: Keycloak Connection Issues
# Test Keycloak connectivity
curl -k https://$KEYCLOAK_URL/auth/realms/openshift/.well-known/openid_configuration

# Check Keycloak logs
oc logs -l app=keycloak -n keycloak-system
Issue 4: User Authentication Failures
# Check OAuth configuration
oc get oauth cluster -o yaml

# Verify identity provider configuration
oc describe oauth cluster

# Check authentication logs
oc logs -l app=oauth-openshift -n openshift-authentication | grep ERROR
Verification Commands
Verify SSO Configuration
# Check OAuth configuration
oc get oauth cluster -o jsonpath='{.spec.identityProviders[0].name}'

# List configured identity providers
oc get oauth cluster -o jsonpath='{.spec.identityProviders[*].name}'

# Check user identities
oc get users
oc get identities
Verify Keycloak Status
# Check Keycloak deployment
oc get keycloak -n keycloak-system
oc get pods -n keycloak-system

# Test Keycloak endpoint
curl -k https://$KEYCLOAK_URL/auth/realms/openshift
Verify Multi-Cluster Access
# Test access to both clusters
for context in cluster1 cluster2; do
    echo "Testing $context..."
    oc config use-context $context
    oc whoami
    oc auth can-i get pods
    echo "---"
done
