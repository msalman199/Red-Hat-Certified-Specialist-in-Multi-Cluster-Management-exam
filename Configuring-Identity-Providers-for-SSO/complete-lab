Task 1: Set up Identity Providers for Centralized Authentication
Subtask 1.1: Deploy Keycloak Identity Provider
First, we'll deploy Keycloak as our centralized identity provider.

Step 1: Create Keycloak Namespace
# Create a dedicated namespace for Keycloak
oc new-project keycloak-system

# Verify namespace creation
oc get projects | grep keycloak
Step 2: Deploy Keycloak Operator
# Create the operator subscription
cat << EOF | oc apply -f -
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: keycloak-operator
  namespace: keycloak-system
spec:
  channel: stable
  installPlanApproval: Automatic
  name: keycloak-operator
  source: community-operators
  sourceNamespace: openshift-marketplace
EOF
Step 3: Wait for Operator Installation
# Check operator installation status
oc get csv -n keycloak-system

# Wait for the operator to be ready (this may take 2-3 minutes)
oc wait --for=condition=Succeeded csv -l operators.coreos.com/keycloak-operator.keycloak-system -n keycloak-system --timeout=300s
Step 4: Deploy Keycloak Instance
# Create Keycloak instance
cat << EOF | oc apply -f -
apiVersion: keycloak.org/v1alpha1
kind: Keycloak
metadata:
  name: keycloak-sso
  namespace: keycloak-system
spec:
  instances: 1
  externalAccess:
    enabled: true
  podDisruptionBudget:
    enabled: true
EOF
Step 5: Verify Keycloak Deployment
# Check Keycloak pod status
oc get pods -n keycloak-system

# Get Keycloak route
oc get routes -n keycloak-system

# Wait for Keycloak to be ready
oc wait --for=condition=Ready keycloak/keycloak-sso -n keycloak-system --timeout=600s
Subtask 1.2: Configure Keycloak Realm and Client
Step 1: Access Keycloak Admin Console
# Get Keycloak admin credentials
KEYCLOAK_USER=$(oc get secret credential-keycloak-sso -n keycloak-system -o jsonpath='{.data.ADMIN_USERNAME}' | base64 -d)
KEYCLOAK_PASSWORD=$(oc get secret credential-keycloak-sso -n keycloak-system -o jsonpath='{.data.ADMIN_PASSWORD}' | base64 -d)

# Get Keycloak URL
KEYCLOAK_URL=$(oc get route keycloak -n keycloak-system -o jsonpath='{.spec.host}')

echo "Keycloak Admin Console: https://$KEYCLOAK_URL"
echo "Username: $KEYCLOAK_USER"
echo "Password: $KEYCLOAK_PASSWORD"
Step 2: Create Keycloak Realm via API
# Create a new realm for OpenShift authentication
cat << EOF > openshift-realm.json
{
  "realm": "openshift",
  "enabled": true,
  "displayName": "OpenShift SSO Realm",
  "loginTheme": "keycloak",
  "accountTheme": "keycloak",
  "adminTheme": "keycloak",
  "emailTheme": "keycloak",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true
}
EOF

# Get access token
ACCESS_TOKEN=$(curl -s -X POST "https://$KEYCLOAK_URL/auth/realms/master/protocol/openid-connect/token" \
  -H "Content-Type: application/x-www-form-urlencoded" \
  -d "username=$KEYCLOAK_USER" \
  -d "password=$KEYCLOAK_PASSWORD" \
  -d "grant_type=password" \
  -d "client_id=admin-cli" | jq -r '.access_token')

# Create the realm
curl -s -X POST "https://$KEYCLOAK_URL/auth/admin/realms" \
  -H "Authorization: Bearer $ACCESS_TOKEN" \
  -H "Content-Type: application/json" \
  -d @openshift-realm.json
Step 3: Create OpenShift Client
# Create OpenShift client configuration
cat << EOF > openshift-client.json
{
  "clientId": "openshift",
  "name": "OpenShift Console",
  "description": "OpenShift Console Client",
  "enabled": true,
  "clientAuthenticatorType": "client-secret",
  "secret": "openshift-client-secret",
  "redirectUris": [
    "https://oauth-openshift.apps.*/*",
    "https://console-openshift-console.apps.*/*"
  ],
  "webOrigins": [
    "https://oauth-openshift.apps.*",
    "https://console-openshift-console.apps.*"
  ],
  "protocol": "openid-connect",
  "attributes": {
    "saml.assertion.signature": "false",
    "saml.force.post.binding": "false",
    "saml.multivalued.roles": "false",
    "saml.encrypt": "false",
    "saml.server.signature": "false",
    "saml.server.signature.keyinfo.ext": "false",
    "exclude.session.state.from.auth.response": "false",
    "saml_force_name_id_format": "false",
    "saml.client.signature": "false",
    "tls.client.certificate.bound.access.tokens": "false",
    "saml.authnstatement": "false",
    "display.on.consent.screen": "false",
    "saml.onetimeuse.condition": "false"
  },
  "authenticationFlowBindingOverrides": {},
  "fullScopeAllowed": true,
  "nodeReRegistrationTimeout": -1,
  "defaultClientScopes": [
    "web-origins",
    "role_list",
    "profile",
    "roles",
    "email"
  ],
  "optionalClientScopes": [
    "address",
    "phone",
    "offline_access",
    "microprofile-jwt"
  ]
}
EOF

# Create the client
curl -s -X POST "https://$KEYCLOAK_URL/auth/admin/realms/openshift/clients" \
  -H "Authorization: Bearer $ACCESS_TOKEN" \
  -H "Content-Type: application/json" \
  -d @openshift-client.json
