Subtask 1.6: Create Cross-Cluster Access Tokens
We need to create tokens that allow tenants to access both clusters.

Create token extraction script:
cat > extract-tokens.sh << 'EOF'
#!/bin/bash

# Function to get service account token
get_sa_token() {
    local context=$1
    local namespace=$2
    local sa_name=$3
    
    kubectl config use-context $context
    
    # Get the secret name for the service account
    SECRET_NAME=$(kubectl get serviceaccount $sa_name -n $namespace -o jsonpath='{.secrets[0].name}')
    
    if [ -z "$SECRET_NAME" ]; then
        # For newer Kubernetes versions, create a token manually
        kubectl create token $sa_name -n $namespace --duration=24h
    else
        # For older versions, extract from secret
        kubectl get secret $SECRET_NAME -n $namespace -o jsonpath='{.data.token}' | base64 -d
    fi
}

echo "Extracting tokens for cluster-a..."
echo "Alpha user token (cluster-a):"
ALPHA_TOKEN_A=$(get_sa_token cluster-a tenant-alpha alpha-user)
echo $ALPHA_TOKEN_A > alpha-token-cluster-a.txt

echo "Beta user token (cluster-a):"
BETA_TOKEN_A=$(get_sa_token cluster-a tenant-beta beta-user)
echo $BETA_TOKEN_A > beta-token-cluster-a.txt

echo "Extracting tokens for cluster-b..."
echo "Alpha user token (cluster-b):"
ALPHA_TOKEN_B=$(get_sa_token cluster-b tenant-alpha alpha-user)
echo $ALPHA_TOKEN_B > alpha-token-cluster-b.txt

echo "Beta user token (cluster-b):"
BETA_TOKEN_B=$(get_sa_token cluster-b tenant-beta beta-user)
echo $BETA_TOKEN_B > beta-token-cluster-b.txt

echo "Tokens extracted successfully!"
EOF

chmod +x extract-tokens.sh
./extract-tokens.sh
Create kubeconfig files for each tenant:
cat > create-tenant-kubeconfigs.sh << 'EOF'
#!/bin/bash

# Get cluster information
CLUSTER_A_SERVER=$(kubectl config view -o jsonpath='{.clusters[?(@.name=="cluster-a")].cluster.server}')
CLUSTER_B_SERVER=$(kubectl config view -o jsonpath='{.clusters[?(@.name=="cluster-b")].cluster.server}')

# Create kubeconfig for tenant-alpha
cat > alpha-kubeconfig.yaml << EOL
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: $CLUSTER_A_SERVER
    insecure-skip-tls-verify: true
  name: cluster-a
- cluster:
    server: $CLUSTER_B_SERVER
    insecure-skip-tls-verify: true
  name: cluster-b
contexts:
- context:
    cluster: cluster-a
    namespace: tenant-alpha
    user: alpha-user
  name: alpha-cluster-a
- context:
    cluster: cluster-b
    namespace: tenant-alpha
    user: alpha-user
  name: alpha-cluster-b
current-context: alpha-cluster-a
users:
- name: alpha-user
  user:
    token: $(cat alpha-token-cluster-a.txt)
EOL

# Create kubeconfig for tenant-beta
cat > beta-kubeconfig.yaml << EOL
apiVersion: v1
kind: Config
clusters:
- cluster:
    server: $CLUSTER_A_SERVER
    insecure-skip-tls-verify: true
  name: cluster-a
- cluster:
    server: $CLUSTER_B_SERVER
    insecure-skip-tls-verify: true
  name: cluster-b
contexts:
- context:
    cluster: cluster-a
    namespace: tenant-beta
    user: beta-user
  name: beta-cluster-a
- context:
    cluster: cluster-b
    namespace: tenant-beta
    user: beta-user
  name: beta-cluster-b
current-context: beta-cluster-a
users:
- name: beta-user
  user:
    token: $(cat beta-token-cluster-a.txt)
EOL

echo "Tenant kubeconfig files created successfully!"
EOF

