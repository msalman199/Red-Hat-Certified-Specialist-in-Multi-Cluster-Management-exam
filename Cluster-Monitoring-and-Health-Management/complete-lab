Task 1: Set Up Cluster Health Monitoring and Logging
Subtask 1.1: Enable Observability in RHACM
First, we'll enable the observability service in RHACM to collect metrics and logs from managed clusters.

Access the RHACM Hub Cluster
# Login to the hub cluster
oc login -u admin -p admin https://api.hub-cluster.example.com:6443

# Verify RHACM installation
oc get pods -n open-cluster-management
Create Observability Namespace
# Create the observability namespace
oc create namespace open-cluster-management-observability

# Verify namespace creation
oc get namespace open-cluster-management-observability
Configure Object Storage for Observability
Create a secret for object storage (using MinIO as an example):

# Create storage secret
cat << EOF | oc apply -f -
apiVersion: v1
kind: Secret
metadata:
  name: thanos-object-storage
  namespace: open-cluster-management-observability
type: Opaque
stringData:
  thanos.yaml: |
    type: s3
    config:
      bucket: "observability-bucket"
      endpoint: "minio.minio.svc.cluster.local:9000"
      insecure: true
      access_key: "minio"
      secret_key: "minio123"
EOF
Create MultiClusterObservability Custom Resource
cat << EOF | oc apply -f -
apiVersion: observability.open-cluster-management.io/v1beta2
kind: MultiClusterObservability
metadata:
  name: observability
  namespace: open-cluster-management-observability
spec:
  observabilityAddonSpec:
    enableMetrics: true
    interval: 30
  storageConfig:
    metricObjectStorage:
      name: thanos-object-storage
      key: thanos.yaml
    storageClass: gp2
    alertmanagerStorageSize: 1Gi
    compactStorageSize: 100Gi
    ruleStorageSize: 1Gi
    receiveStorageSize: 100Gi
    storeStorageSize: 10Gi
EOF
Subtask 1.2: Verify Observability Components
Check Observability Pods Status
# Monitor observability pods deployment
watch oc get pods -n open-cluster-management-observability

# Wait for all pods to be running (this may take 5-10 minutes)
oc get pods -n open-cluster-management-observability | grep -v Running
Verify Metrics Collection
# Check if metrics are being collected
oc get managedclusteraddons -A | grep observability

# Verify observability addon status
oc describe managedclusteraddon observability-addon -n cluster1
Subtask 1.3: Configure Cluster Logging
Enable Cluster Logging on Managed Clusters
# Switch to managed cluster context
oc config use-context cluster1

# Create logging namespace
oc create namespace openshift-logging

# Install cluster logging operator
cat << EOF | oc apply -f -
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: cluster-logging
  namespace: openshift-logging
spec:
  channel: stable
  name: cluster-logging
  source: redhat-operators
  sourceNamespace: openshift-marketplace
EOF
Configure ClusterLogging Instance
# Wait for operator to be ready
oc wait --for=condition=Ready pod -l name=cluster-logging-operator -n openshift-logging --timeout=300s

# Create ClusterLogging instance
cat << EOF | oc apply -f -
apiVersion: logging.coreos.com/v1
kind: ClusterLogging
metadata:
  name: instance
  namespace: openshift-logging
spec:
  managementState: Managed
  logStore:
    type: elasticsearch
    retentionPolicy:
      application:
        maxAge: 7d
      infra:
        maxAge: 7d
      audit:
        maxAge: 7d
    elasticsearch:
      nodeCount: 1
      storage:
        storageClassName: gp2
        size: 10G
      resources:
        requests:
          memory: 2Gi
        limits:
          memory: 2Gi
  visualization:
    type: kibana
    kibana:
      replicas: 1
  collection:
    logs:
      type: fluentd
      fluentd: {}
EOF
Task 2: Test and Validate Automatic Version Upgrades
Subtask 2.1: Configure Cluster Update Policies
Switch Back to Hub Cluster
# Return to hub cluster context
oc config use-context hub-cluster

# Verify current cluster versions
oc get managedclusters -o custom-columns=NAME:.metadata.name,VERSION:.status.version.kubernetes
Create ClusterImageSet for Target Version
# Check available cluster image sets
oc get clusterimageset

# Create a new cluster image set for upgrade
cat << EOF | oc apply -f -
apiVersion: hive.openshift.io/v1
kind: ClusterImageSet
metadata:
  name: img4.12.0-x86-64
spec:
  releaseImage: quay.io/openshift-release-dev/ocp-release:4.12.0-x86_64
EOF
Create Upgrade Policy
cat << EOF | oc apply -f -
apiVersion: policy.open-cluster-management.io/v1
kind: Policy
metadata:
  name: cluster-upgrade-policy
  namespace: default
spec:
  remediationAction: enforce
  disabled: false
  policy-templates:
    - objectDefinition:
        apiVersion: policy.open-cluster-management.io/v1
        kind: ConfigurationPolicy
        metadata:
          name: cluster-upgrade-config
        spec:
          remediationAction: enforce
          severity: high
          object-templates:
            - complianceType: musthave
              objectDefinition:
                apiVersion: config.openshift.io/v1
                kind: ClusterVersion
                metadata:
                  name: version
                spec:
                  desiredUpdate:
                    version: "4.12.0"
                    image: quay.io/openshift-release-dev/ocp-release:4.12.0-x86_64
---
apiVersion: policy.open-cluster-management.io/v1
kind: PlacementBinding
metadata:
  name: cluster-upgrade-binding
  namespace: default
spec:
  bindingOverrides:
    remediationAction: enforce
  placementRef:
    name: cluster-upgrade-placement
    kind: PlacementRule
    apiGroup: apps.open-cluster-management.io
  subjects:
    - name: cluster-upgrade-policy
      kind: Policy
      apiGroup: policy.open-cluster-management.io
---
apiVersion: apps.open-cluster-management.io/v1
kind: PlacementRule
metadata:
  name: cluster-upgrade-placement
  namespace: default
spec:
  clusterConditions:
    - status: "True"
      type: ManagedClusterConditionAvailable
  clusterSelector:
    matchLabels:
      environment: development
EOF
Subtask 2.2: Monitor Upgrade Progress
Check Upgrade Status
# Monitor policy compliance
oc get policy cluster-upgrade-policy -o yaml

# Check cluster version status on managed cluster
oc --context=cluster1 get clusterversion version -o yaml
Create Upgrade Monitoring Script
cat << 'EOF' > monitor-upgrade.sh
#!/bin/bash

echo "Monitoring cluster upgrade progress..."
echo "======================================"

while true; do
    echo "$(date): Checking upgrade status..."
    
    # Check hub cluster policy status
    echo "Policy Status:"
    oc get policy cluster-upgrade-policy -o jsonpath='{.status.compliant}' 2>/dev/null || echo "Policy not found"
    
    # Check managed cluster version
    echo "Managed Cluster Version:"
    oc --context=cluster1 get clusterversion version -o jsonpath='{.status.desired.version}' 2>/dev/null || echo "Cannot connect to managed cluster"
    
    # Check upgrade progress
    echo "Upgrade Progress:"
    oc --context=cluster1 get clusterversion version -o jsonpath='{.status.conditions[?(@.type=="Progressing")].message}' 2>/dev/null || echo "No progress info"
    
    echo "------------------------"
    sleep 60
done
EOF

chmod +x monitor-upgrade.sh
Run Upgrade Monitoring
# Start monitoring (run in background)
./monitor-upgrade.sh &
MONITOR_PID=$!

# You can stop monitoring later with:
# kill $MONITOR_PID
Subtask 2.3: Validate Upgrade Completion
Verify Successful Upgrade
# Check final cluster version
oc --context=cluster1 get clusterversion version -o jsonpath='{.status.history[0].version}'

# Verify cluster operators are stable
oc --context=cluster1 get clusteroperators | grep -v "True.*False.*False"

# Check node versions
oc --context=cluster1 get nodes -o wide
Validate Cluster Health Post-Upgrade
# Check all pods are running
oc --context=cluster1 get pods --all-namespaces | grep -v Running | grep -v Completed

# Verify critical services
oc --context=cluster1 get pods -n openshift-apiserver
oc --context=cluster1 get pods -n openshift-controller-manager
