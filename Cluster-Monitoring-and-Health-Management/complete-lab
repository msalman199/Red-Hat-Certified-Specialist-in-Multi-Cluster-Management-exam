Subtask 3.2: Monitor Cluster Health via CLI
Check Managed Cluster Status
# List all managed clusters with status
oc get managedclusters -o custom-columns=NAME:.metadata.name,AVAILABLE:.status.conditions[0].status,JOINED:.status.conditions[1].status

# Get detailed cluster information
oc describe managedcluster cluster1
Monitor Cluster Conditions
# Create cluster health monitoring script
cat << 'EOF' > cluster-health-check.sh
#!/bin/bash

echo "RHACM Cluster Health Report"
echo "=========================="
echo "Generated: $(date)"
echo ""

# Check hub cluster health
echo "Hub Cluster Status:"
echo "-------------------"
oc get pods -n open-cluster-management | grep -v Running | wc -l | xargs echo "Non-running pods:"
oc get managedclusters --no-headers | wc -l | xargs echo "Total managed clusters:"

echo ""

# Check each managed cluster
echo "Managed Clusters Health:"
echo "------------------------"

for cluster in $(oc get managedclusters -o name | cut -d'/' -f2); do
    echo "Cluster: $cluster"
    
    # Check availability
    available=$(oc get managedcluster $cluster -o jsonpath='{.status.conditions[?(@.type=="ManagedClusterConditionAvailable")].status}')
    echo "  Available: $available"
    
    # Check join status
    joined=$(oc get managedcluster $cluster -o jsonpath='{.status.conditions[?(@.type=="ManagedClusterJoined")].status}')
    echo "  Joined: $joined"
    
    # Check version
    version=$(oc get managedcluster $cluster -o jsonpath='{.status.version.kubernetes}')
    echo "  Version: $version"
    
    # Check last heartbeat
    heartbeat=$(oc get managedcluster $cluster -o jsonpath='{.status.conditions[?(@.type=="ManagedClusterConditionAvailable")].lastTransitionTime}')
    echo "  Last Heartbeat: $heartbeat"
    
    echo ""
done

# Check observability status
echo "Observability Status:"
echo "--------------------"
oc get pods -n open-cluster-management-observability | grep -v Running | wc -l | xargs echo "Non-running observability pods:"

# Check policy compliance
echo "Policy Compliance:"
echo "------------------"
oc get policies --all-namespaces --no-headers | wc -l | xargs echo "Total policies:"
oc get policies --all-namespaces -o jsonpath='{.items[?(@.status.compliant=="NonCompliant")].metadata.name}' | wc -w | xargs echo "Non-compliant policies:"

EOF

chmod +x cluster-health-check.sh
Run Health Check
# Execute health check
./cluster-health-check.sh

# Save report to file
./cluster-health-check.sh > cluster-health-report-$(date +%Y%m%d-%H%M%S).txt
Subtask 3.3: Set Up Automated Health Monitoring
Create Health Monitoring CronJob
cat << EOF | oc apply -f -
apiVersion: batch/v1
kind: CronJob
metadata:
  name: cluster-health-monitor
  namespace: open-cluster-management
spec:
  schedule: "*/15 * * * *"  # Every 15 minutes
  jobTemplate:
    spec:
      template:
        spec:
          serviceAccountName: cluster-health-monitor
          containers:
          - name: health-check
            image: registry.redhat.io/ubi8/ubi:latest
            command:
            - /bin/bash
            - -c
            - |
              # Install oc client
              curl -L https://mirror.openshift.com/pub/openshift-v4/clients/ocp/stable/openshift-client-linux.tar.gz | tar xz
              mv oc /usr/local/bin/
              
              # Run health checks
              echo "Cluster Health Check - $(date)"
              oc get managedclusters
              oc get pods -n open-cluster-management-observability | grep -v Running || echo "All observability pods running"
              
              # Check for alerts (if Prometheus is configured)
              echo "Checking for critical alerts..."
              oc get prometheusrules -A | grep -i critical || echo "No critical alert rules found"
          restartPolicy: OnFailure
EOF
Create Service Account for Monitoring
# Create service account
oc create serviceaccount cluster-health-monitor -n open-cluster-management

# Create cluster role binding
oc create clusterrolebinding cluster-health-monitor \
  --clusterrole=cluster-admin \
  --serviceaccount=open-cluster-management:cluster-health-monitor
Subtask 3.4: Configure Alerting
Create Alert Rules for Cluster Health
cat << EOF | oc apply -f -
apiVersion: monitoring.coreos.com/v1
kind: PrometheusRule
metadata:
  name: rhacm-cluster-health-alerts
  namespace: open-cluster-management-observability
spec:
  groups:
  - name: rhacm.cluster.health
    rules:
    - alert: ManagedClusterDown
      expr: acm_managed_cluster_info{managed_cluster_id!=""} == 0
      for: 5m
      labels:
        severity: critical
      annotations:
        summary: "Managed cluster {{ \$labels.managed_cluster_id }} is down"
        description: "Managed cluster {{ \$labels.managed_cluster_id }} has been unavailable for more than 5 minutes."
    
    - alert: ClusterUpgradeFailed
      expr: increase(cluster_version_operator_update_retrieval_timestamp[1h]) == 0 and cluster_version_operator_update_retrieval_timestamp > 0
      for: 30m
      labels:
        severity: warning
      annotations:
        summary: "Cluster upgrade may have failed"
        description: "Cluster upgrade has not progressed in the last 30 minutes."
    
    - alert: ObservabilityComponentDown
      expr: up{job=~".*observability.*"} == 0
      for: 10m
      labels:
        severity: warning
      annotations:
        summary: "Observability component is down"
        description: "Observability component {{ \$labels.job }} has been down for more than 10 minutes."
EOF
Verify Alert Rules
# Check if alert rules are loaded
oc get prometheusrules -n open-cluster-management-observability

# Check Prometheus targets
oc get route prometheus -n open-cluster-management-observability -o jsonpath='{.spec.host}'
Troubleshooting Common Issues
Issue 1: Observability Pods Not Starting
Symptoms: Observability pods stuck in Pending or CrashLoopBackOff state

Solution:

# Check storage class availability
oc get storageclass

# Verify object storage connectivity
oc logs deployment/observability-thanos-receive -n open-cluster-management-observability

# Check resource requirements
oc describe pod -l app=multicluster-observability-operator -n open-cluster-management-observability
Issue 2: Managed Cluster Not Reporting Metrics
Symptoms: No metrics visible for managed cluster in Grafana

Solution:

# Check observability addon status
oc get managedclusteraddons -A | grep observability

# Restart observability addon
oc delete managedclusteraddon observability-addon -n cluster1
# Wait for automatic recreation

# Check metrics endpoint
oc --context=cluster1 get pods -n open-cluster-management-addon-observability
Issue 3: Upgrade Policy Not Applied
Symptoms: Cluster upgrade policy shows as non-compliant

Solution:

# Check placement rule
oc get placementrule cluster-upgrade-placement -o yaml

# Verify cluster labels
oc get managedcluster cluster1 --show-labels

# Check policy template syntax
oc get policy cluster-upgrade-policy -o yaml | grep -A 20 object-templates
