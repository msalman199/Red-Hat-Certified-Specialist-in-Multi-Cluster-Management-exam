  generators:
  - list:
      elements:
      - cluster: dev-cluster
        url: https://kubernetes.default.svc
        namespace: guestbook-dev
        environment: development
      - cluster: staging-cluster
        url: https://kubernetes.default.svc
        namespace: guestbook-staging
        environment: staging
      - cluster: prod-cluster
