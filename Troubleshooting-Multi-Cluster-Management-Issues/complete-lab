Task 2: Diagnosing Cluster Health and Resource Problems
Subtask 2.1: Building a Cluster Health Checker
Step 1: Create a comprehensive health check script

cat > cluster-health-check.sh << 'EOF'
#!/bin/bash

CLUSTER_NAME=${1:-"all"}

check_cluster_health() {
    local cluster=$1
    echo "=== Health Check for Cluster: $cluster ==="

    echo "Cluster Info:"
    oc get managedcluster "$cluster" -o custom-columns=NAME:.metadata.name,VERSION:.status.version.kubernetes,AVAILABLE:.status.conditions[0].status

    echo "Cluster Conditions:"
    oc get managedcluster "$cluster" -o jsonpath='{range .status.conditions[*]}{.type}{"\t"}{.status}{"\t"}{.message}{"\n"}{end}'

    echo "Addon Status:"
    oc get managedclusteraddons -n "$cluster"

    echo "Recent Non-Normal Events:"
    oc get events -n "$cluster" --sort-by='.lastTimestamp' --field-selector type!=Normal 2>/dev/null | tail -10
}

if [ "$CLUSTER_NAME" = "all" ]; then
    for cluster in $(oc get managedclusters -o name | cut -d'/' -f2); do
        check_cluster_health "$cluster"
        echo "----------------------------------------"
    done
else
    check_cluster_health "$CLUSTER_NAME"
fi
EOF

chmod +x cluster-health-check.sh
./cluster-health-check.sh
Expected output: for each managed cluster, a block showing kubernetes version, availability status, per-condition detail lines, addon status table (e.g., application-manager, cert-policy-controller all Available: True), and any recent warning/error events.

Subtask 2.2: Diagnosing Connectivity and Resource Constraints
Step 1: Create a network connectivity tester

cat > network-connectivity-test.sh << 'EOF'
#!/bin/bash

CLUSTER_NAME=${1:-cluster1}

echo "=== Network Connectivity Test for $CLUSTER_NAME ==="

CLUSTER_ENDPOINT=$(oc get managedcluster "$CLUSTER_NAME" -o jsonpath='{.spec.managedClusterClientConfigs[0].url}')
echo "Cluster endpoint: $CLUSTER_ENDPOINT"

if [ -n "$CLUSTER_ENDPOINT" ]; then
    curl -k --connect-timeout 10 "$CLUSTER_ENDPOINT/healthz" || echo "Endpoint not reachable"
